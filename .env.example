# Hostnames only: no scheme, path, or trailing slash.
# Both DNS A records must point to the VPS public IP.
APP_HOST=play.example.com
GAME_HOST=game.example.com

# Optional client build-time STUN endpoint (default shown; NOT a TURN relay).
# Set in the process environment for local builds; Docker requires explicitly forwarding a build ARG.
# NEXT_PUBLIC_VOICE_STUN_URL=stun:stun.l.google.com:19302
